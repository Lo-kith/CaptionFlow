# ─── CaptionFlow environment ────────────────────────────────────────────────
# Every value below is OPTIONAL — each one has a built-in default,
# so the app runs fine with no .env file at all.

# Local Whisper model size: tiny | base | small | medium | large
# (or a full HF model id, e.g. Xenova/whisper-small.en)
# base = good accuracy/speed balance. small & medium are markedly slower on CPU.
WHISPER_MODEL=base

# Maximum upload size in MB (default: 500)
MAX_FILE_SIZE_MB=500

# ─── Docker / production only ───────────────────────────────────────────────
# Where downloaded Whisper models are cached. Without this, @huggingface/
# transformers v4 defaults to node_modules/@huggingface/transformers/.cache,
# which is wiped on every image rebuild — the ~150 MB model re-downloads each
# time. Point it at a persistent volume.
# WHISPER_CACHE_DIR=/data/models

# Scratch space for uploads + extracted audio (defaults to os.tmpdir()/captionflow).
# Mount a volume here or long videos will fill the container's writable layer.
# TEMP_DIR=/data/temp

# ─── Note ───────────────────────────────────────────────────────────────────
# The upload UI reads NEXT_PUBLIC_MAX_FILE_SIZE_MB, but the server-side limit
# reads MAX_FILE_SIZE_MB. Set both to keep the label and the enforced cap in sync.
# NEXT_PUBLIC_MAX_FILE_SIZE_MB=500