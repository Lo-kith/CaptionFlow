# CaptionFlow Environment Variables

# Local Whisper Model size (tiny | base | small | medium | large | Xenova/whisper-base)
WHISPER_MODEL=base

# Maximum upload size in MB (default: 500)
MAX_FILE_SIZE_MB=500

# Optional: Override temp directory (defaults to os.tmpdir()/captionflow)
# TEMP_DIR=/tmp/captionflow
